{
    "model_type": "Multitask Multivariate 2D-CNN",
    "input_shape": [
        4,
        20,
        1
    ],
    "features": [
        "fx_log_return",
        "fx_return_squared",
        "brent_log_return",
        "reserves_log_change"
    ],
    "window_size": 20,
    "continuous_target": "next_period_fx_return_squared",
    "continuous_target_transform": "log1p",
    "continuous_inverse_transform": "expm1",
    "spike_definition": "next_period_fx_return_squared > frozen threshold",
    "spike_threshold": 0.10927724,
    "classification_cutoff": 0.5,
    "training_period": "2006-05-09 to 2013-12-31",
    "validation_period": "2014-01-02 to 2020-12-31",
    "final_test_period": "2021-01-04 to 2025-10-29",
    "volatility_loss": "Huber",
    "spike_loss": "BinaryCrossentropy",
    "volatility_loss_weight": 0.3,
    "spike_loss_weight": 0.7,
    "nonspike_class_weight": 0.5145888594164456,
    "spike_class_weight": 17.636363636363637,
    "epochs_max": 100,
    "batch_size": 32,
    "learning_rate": 0.001,
    "random_seed": 42,
    "shuffle": false,
    "architecture": [
        "Conv2D(32, kernel=(2,3), activation=relu)",
        "MaxPooling2D(pool=(2,2))",
        "Conv2D(64, kernel=(2,3), activation=relu)",
        "Flatten",
        "Dense(64, activation=relu)",
        "Dropout(0.30)",
        "Volatility Dense(32, activation=relu)",
        "Volatility output Dense(1, activation=softplus)",
        "Spike Dense(32, activation=relu)",
        "Spike output Dense(1, activation=sigmoid)"
    ]
}